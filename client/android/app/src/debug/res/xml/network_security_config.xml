<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow cleartext http/ws so the app can reach a
     dev server on the LAN (e.g. http://192.168.x.x:8000). Release builds
     keep Android's default https-only policy. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
