# Origin of the server (no trailing slash). The build derives the API and
# websocket URLs from this. Copy to .env and override per environment.
#
#   local browser dev : http://localhost:8000
#   device on the LAN : http://192.168.x.x:8000   (your machine's IP)
#   production        : https://chat.example.com  (https -> wss automatically)
SERVER_ORIGIN=http://localhost:8000
